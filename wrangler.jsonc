{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aly-hz",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2b9257e5-e70d-45dd-96a9-968a1c3f2378","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4a8a1dee9eec4880afc1031ebd222b90" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
